  "pairlists": [
    {
      "_comment": "静态白名单，不做动态过滤；72 个 pair 全部由 FreqAI 独立训练。",
      "method": "StaticPairList"
    }
  ],
  "order_types": {
    "_comment": "限价进出场。stoploss 类型仍为 market，但策略已用 stoploss=-1.0 让固定止损不触发；stoploss_on_exchange=false 表示不在交易所挂止损单。",
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "freqaimodel": "XGBoostRegressor",
  "freqai": {
    "_comment": "回归模型：预测未来 3 根 4h K 线的收益率，目标列 &-s_return。identifier 是模型与预测缓存命名空间，改特征/标签/模型必须换新值。label_period_candles=3 即预测未来 3 根 K 线。eval_metric 必须是 rmse，不能沿用分类的 mlogloss。",
    "enabled": true,
    "purge_old_models": 2,
    "train_period_days": 365,
    "backtest_period_days": 7,
    "save_backtest_models": false,
    "live_retrain_hours": 24,
    "identifier": "mystrategy-4h-regression-72pair-v1",
    "feature_parameters": {
      "include_timeframes": [
        "4h"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 3,
      "include_shifted_candles": 2,
      "DI_threshold": 2.0,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [
        6,
        14,
        24
      ],
      "plot_feature_importances": 1
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "shuffle": false,
      "random_state": 42
    },
    "model_training_parameters": {
      "n_estimators": 500,
      "max_depth": 5,
      "learning_rate": 0.05,
      "subsample": 0.8,
      "colsample_bytree": 0.8,
      "eval_metric": "rmse",
      "early_stopping_rounds": 10,
      "verbosity": 1,
      "n_jobs": -1,
      "tree_method": "hist"
    }
  },
  "my_experiment": {
    "_comment": "策略自定义开关，由 MyStrategy._experiment_config 读取。label=volnorm 表示标签为 未来收益率/ATR 归一化（raw 为原始收益率）；entry_threshold 是入场阈值，与标签同尺度；probe=true 会把跨 pair 对齐审计写入仓库 logs/align_audit.jsonl，生产应保持 false。",
    "label": "volnorm",
    "features": [],
    "entry_threshold": 0.4,
    "probe": false
  },
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 60
  }
}
