{
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "max_open_trades": 3,
  "stake_currency": "USDT",
  "stake_amount": 20.0,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "timeframe": "1h",
  "dry_run": true,
  "dry_run_wallet": 100,
  "fee": 0.0005,
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {
      "timeout": 120000,
      "enableRateLimit": true,
      "proxies": {
        "http": "http://127.0.0.1:7890",
        "https": "http://127.0.0.1:7890"
      }
    },
    "ccxt_async_config": {
      "timeout": 120000,
      "enableRateLimit": true,
      "aiohttp_trust_env": true,
      "httpsProxy": "http://127.0.0.1:7890"
    },
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT",
      "SOL/USDT:USDT",
      "XRP/USDT:USDT",
      "DOGE/USDT:USDT",
      "ADA/USDT:USDT",
      "LINK/USDT:USDT",
      "AVAX/USDT:USDT",
      "BNB/USDT:USDT",
      "LTC/USDT:USDT",
      "DOT/USDT:USDT",
      "ATOM/USDT:USDT",
      "NEAR/USDT:USDT",
      "OP/USDT:USDT",
      "INJ/USDT:USDT"
    ],
    "pair_blacklist": []
  },
  "pairlists": [
    {
      "method": "StaticPairList"
    }
  ],
  "liquidation_buffer": 0.05,
  "order_types": {
    "entry": "limit",
    "exit": "limit",
    "stoploss": "market",
    "stoploss_on_exchange": false
  },
  "freqai": {
    "enabled": true,
    "purge_old_models": 0,
    "train_period_days": 365,
    "backtest_period_days": 30,
    "save_backtest_models": true,
    "live_retrain_hours": 720,
    "fit_live_predictions_candles": 600,
    "identifier": "vtech-adverse-1h-decay60-colsample70-minchild16-f",
    "feature_parameters": {
      "include_timeframes": [
        "1h"
      ],
      "include_corr_pairlist": [],
      "label_period_candles": 8,
      "include_shifted_candles": 2,
      "DI_threshold": 2.0,
      "weight_factor": 0.9,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [
        8,
        20,
        48
      ],
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.2,
      "shuffle": false,
      "random_state": 42
    },
    "model_training_parameters": {
      "objective": "reg:squarederror",
      "n_estimators": 600,
      "max_depth": 3,
      "learning_rate": 0.03,
      "subsample": 0.85,
      "colsample_bytree": 0.70,
      "min_child_weight": 16,
      "reg_alpha": 0.1,
      "reg_lambda": 2.0,
      "eval_metric": "mae",
      "early_stopping_rounds": 50,
      "tree_method": "hist",
      "n_jobs": 8,
      "random_state": 42
    }
  },
  "logfile": "user_data/logs/vtech-freqai-risk.log"
}
