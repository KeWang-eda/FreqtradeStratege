{
  "_comment": "仅用于当前 Binance USDT 线性合约历史回测：本地行情仍由 --datadir 读取；市场精度和交易限制仍从真实 exchangeInfo 获取。CCXT 默认加载 spot/linear/inverse，限制为 linear 可避免无关市场请求。不要用于现货、币本位或替代实盘配置。",
  "exchange": {
    "name": "binance",
    "ccxt_config": {
      "options": {
        "fetchMarkets": {
          "types": ["linear"]
        }
      }
    },
    "pair_whitelist": ["BTC/USDT:USDT", "ETH/USDT:USDT", "BNB/USDT:USDT"]
  },
  "pairlists": [{"method": "StaticPairList"}]
  ,"stake_currency": "USDT",
  "stake_amount": 100,
  "dry_run_wallet": 1000,
  "dataformat_ohlcv": "feather",
  "dataformat_trades": "feather"
}
